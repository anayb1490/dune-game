# -----------------------------------------------------------------
# Development (leave blank or omit — Vite proxy handles routing)
# -----------------------------------------------------------------
# VITE_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------
# Production (Vercel + Render deployment)
#
# REST API calls (/api/*) are forwarded by Vercel rewrites — no change needed.
# WebSocket connections CANNOT go through Vercel serverless rewrites.
# They must connect directly to the Render backend.
#
# Set this in Vercel → Project Settings → Environment Variables:
# -----------------------------------------------------------------
VITE_WS_URL=wss://dune-game.onrender.com
